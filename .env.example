# ==============================================================================
# AutoPatch Environment Configuration (.env.example)
# ==============================================================================
# Copy to .env for local development. NEVER commit real secrets or .env files.
# Core AutoPatch (deterministic AST/compiler analysis, sandboxed verification,
# diffing, and append-only audit ledger) boots cleanly with ZERO required secrets.
# Optional integrations auto-disable gracefully when their credentials are absent.

# ------------------------------------------------------------------------------
# A. GEMINI AI INTEGRATION (Auto-provided in Google AI Studio)
# ------------------------------------------------------------------------------
# Server-side Gemini API key (NEVER exposed to browser or execution sandbox).
# Obtain outside AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# B. OPTIONAL NEO4J AURADB GRAPHRAG CREDENTIALS
# ------------------------------------------------------------------------------
# Required ONLY to enable Neo4j GraphRAG. Obtain from https://console.neo4j.io
# -> Select AuraDB instance -> Connection details / downloaded credentials file.
# (AURA_INSTANCEID and AURA_INSTANCENAME are NOT used or required.)
# NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
# NEO4J_USERNAME=<neo4j-username>
# NEO4J_PASSWORD=<neo4j-password>
# NEO4J_DATABASE=neo4j

# ------------------------------------------------------------------------------
# C. OPTIONAL SELF-MANAGED API PROTECTION (Disabled by default)
# ------------------------------------------------------------------------------
# Set only if you want to require Authorization: Bearer <token> or X-API-Key
# on /api/* routes in a multi-tenant deployment. No external dashboard needed.
# AUTOPATCH_API_KEY=

# ------------------------------------------------------------------------------
# D. OPTIONAL RUNTIME OVERRIDES (Safe built-in defaults apply automatically)
# ------------------------------------------------------------------------------
# GRAPHRAG_ENABLED=true
# GRAPHRAG_MAX_TRAVERSAL_DEPTH=2
# GRAPHRAG_MAX_NODES=50
# GRAPHRAG_EMBEDDING_BATCH_SIZE=16
# GEMINI_MODEL=gemini-4-hydrogen
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_EMBEDDING_DIMENSIONS=768
# GEMINI_TIMEOUT_MS=15000
# GEMINI_TRANSCRIBE_TIMEOUT_MS=15000
# GEMINI_DAILY_QUOTA=500
# PORT=3000
# NODE_ENV=development
# DISABLE_HMR=true
# ENABLE_LOCAL_HMR=false
# AUDIT_LOG_PATH=.autopatch-data/audit-ledger.ndjson
# SANDBOX_ALLOW_UNTRUSTED_EXEC=true
# SANDBOX_TIMEOUT_SECONDS=2.0
# SANDBOX_MAX_TIMEOUT_SECONDS=5.0
# SANDBOX_MEMORY_MB=256
# SANDBOX_NODE_HEAP_MB=192
# SANDBOX_CPU_SECONDS=2
# SANDBOX_COMPILE_CPU_SECONDS=5
# SANDBOX_MAX_OUTPUT_BYTES=65536
# SANDBOX_MAX_FILE_BYTES=10485760
# SANDBOX_MAX_OPEN_FILES=64
# SANDBOX_MAX_PROCESSES=32
# MAX_CONCURRENT_EXECUTIONS=4
# MAX_SOURCE_SIZE_BYTES=100000
# MAX_TEST_SIZE_BYTES=100000
# MAX_CONTEXT_SIZE_BYTES=10000
# MAX_AUDIO_SIZE_BYTES=2000000
# MAX_REQUESTS_PER_MINUTE=60
# MAX_AI_REQUESTS_PER_MINUTE=20
# MAX_CONCURRENT_ANALYSES=8
